# App
NODE_ENV=
PORT=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Demo simulate toggles. Web (NEXT_PUBLIC_*) shows the buttons; API (ENABLE_SIMULATE)
# allows the sandbox endpoints in production. Set both to "true" for a live demo.
NEXT_PUBLIC_ENABLE_SIMULATE=
ENABLE_SIMULATE=

# Database
DATABASE_URL=

# Redis
REDIS_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# Stripe Identity (KYC)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Persona (KYC) — legacy; KYC is moving to Stripe Identity above
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
PERSONA_TEMPLATE_ID=

# Plaid (Bank Linking)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Alpaca (Brokerage)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=
ALPACA_DATA_URL=

# App Config
TRADE_APPROVAL_THRESHOLD_CENTS=
REBALANCE_DRIFT_THRESHOLD_PCT=
